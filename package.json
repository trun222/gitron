{
  "name": "gitron",
  "version": "0.5.0",
  "description": "Open-source, AI-native Git GUI built with Rust and Svelte",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:server": "cargo build --release -p gitron-server",
    "server": "cargo run -p gitron-server --",
    "server:dev": "cargo run -p gitron-server -- --host 0.0.0.0 --port ${GITRON_API_PORT:-9417} & vite dev --host 0.0.0.0",
    "server:start": "npm run build && cargo run -p gitron-server -- --frontend-dir ./build"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "md5": "^2.3.0",
    "shiki": "^3.22.0",
    "tailwind-merge": "^3.4.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.11.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/md5": "^2.3.6",
    "@types/node": "^25.3.0",
    "bits-ui": "^2.15.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
